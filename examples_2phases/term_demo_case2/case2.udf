// term_demo_case2 -- Shaver et al., Trans. ANS 116, 2017 (trans_v116_n1_pp1251-1254.pdf),
// Second Test Case: both phases enter at u=1 with a real (nonzero, non-trivial) dispersed
// volume fraction alpha_d(0) = 0.2083 (Table II), and the mixture accelerates/decelerates
// toward the fully-developed state of Table III via gravity + drag, with alpha genuinely
// transported (not hardcoded, unlike term_demo_case1). Exercises: Plan G alpha transport
// with a real udfDirichlet inlet BC, Plan F mixture reconstruction, and drag with a
// VARIABLE drag coefficient.
//
// phase0 = continuous ("c"), phase1 = dispersed ("d") -- fluidSolver_t keys
// o_solution/o_explicitTerms/isField() on "phase<k>" regardless of the [FLUID PHASE <name>]
// section name (velocityName is always "phase"+phaseDigitStr(i)); using "phase0"/"phase1"
// directly here avoids a silent mismatch against a cosmetic name. The alphad SCALAR, by
// contrast, is looked up by its literal par-file name ("alphad"), and its BC dispatch
// string is "scalar alphad" (lowercased "scalar " + name, confirmed from turbPipe's
// "scalar s00" convention) -- NOT the fluid phase name convention above.
//
// *** IMPORTANT TEMPLATE SUBSTITUTION (documented explicitly, per Plan H) ***
// The paper's text states case 2 "includes the effect of ... a variable drag coefficient"
// but the 4 pages available here do NOT give the actual C_D(Re_d) correlation used. There
// is no physically-motivated way to recover the paper's exact curve from what we have, so
// this UDF substitutes the standard Schiller-Naumann correlation,
//   C_D = (24/Re_d) * (1 + 0.15 * Re_d^0.687),  Re_d <= 1000,
// clipped to Stokes drag C_D = 24/Re_d for very small Re_d (and Re_d itself floored away
// from 0 to avoid a divide-by-zero when u_d == u_c exactly, e.g. at t=0 IC). Re_d is formed
// against the SAME nondimensional viscosity used below for the momentum equations'
// numerical regularizer (viscosity = 1e-4 in case2.par) -- the paper's own eq 16/17 have NO
// diffusion term at all ("diffusion terms have been neglected as insignificant"), so that
// viscosity is purely a numerical device, and so is its reuse here as nu_c for Re_d. This
// is a template demonstration of how a variable-C_D drag law gets wired into userSource --
// it is NOT intended to quantitatively reproduce the paper's unpublished (on these 4 pages)
// curve. See read_case2.py for the loose sanity check against Table III.
//
// *** eq 90 DILATION TERM -- KNOWN LIMITATION, not implemented here (see README.md) ***
// scalarSolver_t only implements the NON-conservative transport ∂α/∂t + u.grad(α) =
// D*lap(α); eq 90's real, CONSERVATIVE form adds a dilation term, ∂α_k/∂t + u_k.grad(α_k) +
// α_k*div(u_k) = Gamma_k/rho_k. Without it, a uniform alpha field that already equals its
// Dirichlet BC is an exact fixed point for ANY diffusionCoeff (both u.grad(alpha) and
// D*lap(alpha) vanish identically when grad(alpha)=0) -- alpha_d stays frozen at its inlet
// value (0.2083) rather than relaxing toward Table III's fully-developed value.
// A real attempt to add this term (explicit source, implicit reaction term via
// scalar_t::userImplicitLinearTerm, AVM regularization, [0,1] clamping, under-relaxation --
// every combination tried) is backed up in case2_eq90_attempt.udf/.par: ALL of them produced
// a genuine, likely ill-posed alpha<->pressure/momentum feedback loop that blows up around
// t~0.22-0.32 (see README.md and case2_eq90_instability.png), consistently getting only
// DELAYED, never cured, by stronger mitigation -- the signature of an unstable mode, not a
// fixable discretization bug. Reverted here to the Bug-#2-fix-only state (frozen alpha_d,
// but stable through the full run) rather than ship a case that crashes partway through.

#include "fieldExtract.hpp"

std::unique_ptr<fieldExtract> sampler;

// [CASEDATA] ioSample -- fieldExtract sampling cadence in steps (see case2.par); guards
// against writing far more .vts dumps than needed for a steady spatial profile.
static dlong ioSample;

// Table I (dimensionless).
static constexpr dfloat RHO_C = 1.0;
static constexpr dfloat RHO_D = 0.2;
static constexpr dfloat D_D = 0.5;
static constexpr dfloat GRAV = 0.9807;
static constexpr dfloat NU_C = 1e-4; // == [FLUID VELOCITY] viscosity in case2.par; reused
                                      // here as the nondimensional nu_c for Re_d (see note
                                      // above -- a numerical regularizer repurposed as the
                                      // Schiller-Naumann correlation's viscosity scale).

// Table II: inlet conditions (z=0).
static constexpr dfloat UC_IN = 1.0;
static constexpr dfloat UD_IN = 1.0;
static constexpr dfloat ALPHAD_IN = 0.2083;

#ifdef __okl__

// NOTE: top-level host constants (UC_IN/UD_IN/ALPHAD_IN above) are not visible inside the
// generated OKL kernel source (only the #ifdef __okl__ block's own text is staged into it),
// so Table II's inlet values are written as literals here directly, matching case1's
// convention (its udfDirichlet also uses literals, not CD0/RHO_C/etc).
void udfDirichlet(bcData *bc)
{
  if (isField("phase0")) {
    bc->uxFluid = 1.0; // Table II: u_c(0) = 1
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.0;
  } else if (isField("phase1")) {
    bc->uxFluid = 1.0; // Table II: u_d(0) = 1
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.0;
  } else if (isField("scalar alphad")) {
    bc->sScalar = 0.2083; // Table II: alpha_d(0) = 0.2083
  }
}

// eq 16/17: gravity ("-g") and the drag force F_d (eq 18, now with a variable,
// Schiller-Naumann C_D) enter as accelerations, no density factor -- matches this solver's
// o_EXT/o_JwF convention (confirmed density-free during Plan F). The -(1/rho_k) dP/dz term
// is already supplied by the shared mixture-pressure solve (eq 99/101); this kernel only
// adds what eq 16/17 put beyond that, INCLUDING the (alpha_d/alpha_c)*F_d reaction onto the
// continuous phase, which case1 could skip (alpha_d == 0 there) but is genuinely nonzero
// here. Runs entirely on-device (no host round-trip) -- every `@kernel void` defined here
// gets a matching host-callable wrapper for free, so userf() below just calls this like a
// function (same pattern as term_demo_case1/case1.udf's dragGravityKernel).
@kernel void dragGravityKernel(const dlong N,
                                const dfloat RHO_C,
                                const dfloat RHO_D,
                                const dfloat D_D,
                                const dfloat GRAV,
                                const dfloat NU_C,
                                const dfloat CD_MAX,
                                @ restrict const dfloat *uc,
                                @ restrict const dfloat *ud,
                                @ restrict const dfloat *alphac,
                                @ restrict const dfloat *alphad,
                                @ restrict dfloat *extC,
                                @ restrict dfloat *extD)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat rel = ud[n] - uc[n];
    const dfloat relMag = fabs(rel);

    // Schiller-Naumann drag correlation (TEMPLATE SUBSTITUTION, see header comment) --
    // Re_d against the same nondimensional viscosity used for the momentum equations'
    // numerical regularizer (NU_C == [FLUID VELOCITY] viscosity in case2.par).
    const dfloat Re = (relMag > 1e-6 ? relMag : 1e-6) * D_D / NU_C;
    dfloat CD;
    if (Re < 1e-3) {
      CD = 24.0 / Re; // Stokes regime, avoid the (1+0.15*Re^0.687) correction near Re -> 0
    } else {
      CD = (24.0 / Re) * (1.0 + 0.15 * pow(Re, 0.687));
      if (CD > CD_MAX) {
        CD = CD_MAX; // sane ceiling, see header comment
      }
    }

    const dfloat Fd = -0.75 * (CD / D_D) * relMag * rel; // eq 18

    // alpha_c can be (numerically) exactly 0 in principle; guard the ratio.
    const dfloat ac = (alphac[n] > 1e-6 ? alphac[n] : 1e-6);
    extC[n] = -GRAV - (alphad[n] / ac) * Fd;
    extD[n] = -GRAV + (RHO_C / RHO_D) * Fd;
  }
}

#endif

void userf(double time)
{
  auto &fluid = nrs->fluid;
  const auto N = fluid->mesh->Nlocal;
  const auto fieldOffset = fluid->fieldOffset;

  deviceMemory<dfloat> o_uc(fluid->o_solution("phase0").slice(0, fieldOffset));
  deviceMemory<dfloat> o_ud(fluid->o_solution("phase1").slice(0, fieldOffset));
  deviceMemory<dfloat> o_alphaC(fluid->o_alpha_phases[0]);
  deviceMemory<dfloat> o_alphaD(fluid->o_alpha_phases[1]);
  deviceMemory<dfloat> o_extC(fluid->o_explicitTerms("phase0").slice(0, fieldOffset));
  deviceMemory<dfloat> o_extD(fluid->o_explicitTerms("phase1").slice(0, fieldOffset));

  static constexpr dfloat CD_MAX = 400.0;
  dragGravityKernel(N,
                     RHO_C,
                     RHO_D,
                     D_D,
                     GRAV,
                     NU_C,
                     CD_MAX,
                     o_uc,
                     o_ud,
                     o_alphaC,
                     o_alphaD,
                     o_extC,
                     o_extD);
}

// Plan G alpha-transport hook: runs after scalar->solve() (so "alphad" is current) and
// before fluid's own updateMixtureProperties()/solve() (confirmed call site, nrs.cpp
// ~line 1927) -- exactly the right spot to push the scalar's solution into
// fluid->o_alpha_phases[1] and re-derive o_alpha_phases[0] as an algebraic identity.
// KNOWN LIMITATION (see header comment): alpha_d is frozen at its inlet value by the
// (stable) scalar equation alone, since eq 90's dilation term is not implemented here.
void myPreFluid(double time, int tstep)
{
  auto &fluid = nrs->fluid;
  fluid->setAlphaPhase(1, nrs->scalar->o_solution("alphad"));
  fluid->deriveLastAlphaPhase(0);
}

void UDF_Setup()
{
  auto mesh = nrs->meshV;
  auto &fluid = nrs->fluid;

  platform->par->extract("casedata", "iosample", ioSample);

  nrs->userSource = &userf;
  nrs->preFluid = &myPreFluid;

  // IC: both phases at their inlet velocity, alpha at its inlet value everywhere (uniform
  // IC; the profile then relaxes toward the fully-developed state as the run proceeds).
  {
    auto o_cont = fluid->o_solution("phase0");
    platform->linAlg->fill(o_cont.size(), 0.0, o_cont);
    platform->linAlg->fill(mesh->Nlocal, UC_IN, o_cont.slice(0, fluid->fieldOffset));

    auto o_disp = fluid->o_solution("phase1");
    platform->linAlg->fill(o_disp.size(), 0.0, o_disp);
    platform->linAlg->fill(mesh->Nlocal, UD_IN, o_disp.slice(0, fluid->fieldOffset));

    platform->linAlg->fill(mesh->Nlocal, ALPHAD_IN, fluid->o_alpha_phases[1]);
    platform->linAlg->fill(mesh->Nlocal, 1.0 - ALPHAD_IN, fluid->o_alpha_phases[0]);

    // Scalar IC must match, or the first preFluid call will overwrite alpha_phases[1]
    // with whatever the scalar solver's own (unset) IC was. scalar_t::o_solution() already
    // returns a view sized to the scalar's own fieldOffset (unlike fluid's o_solution(),
    // which returns the full multi-component phase velocity and needs an extra slice()).
    platform->linAlg->fill(mesh->Nlocal, ALPHAD_IN, nrs->scalar->o_solution("alphad"));
  }

  // [fieldExtract] one line along the flow direction (x), sampled at the cross-section
  // centerline, reproducing the spirit of Fig. 2/3 of trans_v116_n1_pp1251-1254.pdf for this
  // case. Validation/plotting happens entirely in Python (read_case2.py) -- this UDF only
  // samples and writes.
  {
    std::vector<int> boxDims = {81, 1, 1}; // npts in X, Y, Z (endpoints included)
    std::vector<fieldExtract::field> fldList;
    deviceMemory<dfloat> o_uc(fluid->o_solution("phase0").slice(0, fluid->fieldOffset));
    deviceMemory<dfloat> o_ud(fluid->o_solution("phase1").slice(0, fluid->fieldOffset));
    deviceMemory<dfloat> o_ad(nrs->scalar->o_solution("alphad"));
    fldList.push_back({"uc", std::vector{o_uc}});
    fldList.push_back({"ud", std::vector{o_ud}});
    fldList.push_back({"alphad", std::vector{o_ad}});

    std::array<dfloat, 3> x0 = {0.0, 0.05, 0.05};
    std::array<dfloat, 3> x1 = {1.0, 0.05, 0.05};
    sampler = std::make_unique<fieldExtract>(mesh, boxDims, fldList, "case2", x0, x1);
  }
}

void UDF_ExecuteStep(double time, int tstep)
{
  // [fieldExtract] sample periodically (cadence from [CASEDATA] ioSample, case2.par); the
  // final dump (lastStep) is the steady profile compared against Table II (inlet)/Table III
  // (outlet). tstep > 0 guard: skip the t=0 IC dump so numSteps/ioSample sets the exact dump
  // count (e.g. 16000/800 = 20), not one extra.
  if ((tstep > 0 && tstep % ioSample == 0) || nrs->lastStep) {
    sampler->process(time, tstep);
  }
  if (nrs->lastStep) {
    sampler.reset(); // unique_ptr::reset -- frees the sampler (and its findpts comm)
                      // before MPI_Finalize, not a method on fieldExtract itself
  }
}
