userSections = CASEDATA

[GENERAL]
# 40 streamwise elements (vs case1's 20) roughly halves the element spacing, so dt had to
# shrink too -- case1's dt=3e-3 blew up here (actual numerical divergence, not just a large
# reported CFL number: resNorm/divUErr grew unboundedly within ~50 steps). Verified stable
# (CFL flat at 0.312 for 500 steps) at dt=5e-4.
# numSteps extended to T=32 (4x the original T=8) with Plan K's eq 90 dilation term retry
# #2 in place: T=8 completed without blowing up, but u_c/u_d/alpha_d were still visibly
# drifting at the outlet (u_c had gone negative, unphysical) -- not yet time-converged, so
# T=8 wasn't long enough to compare against the paper's own STEADY (not transient) 1D model.
polynomialOrder = 7
numSteps = 128000
dt = 2.5e-4
timeStepper = tombo2
checkpointInterval = 32000
scalars = alphad

[FLUID PRESSURE]
residualTol = 1e-06

[FLUID VELOCITY]
# bID1 = inlet (x=0), bID2 = outlet (x=1), bID3 = symmetry (y=0/0.1); boundaryID is
# assigned from cbc in case2.usr's usrdat2 -- genbox's "E"/"SYM" letters alone do not
# become real boundary IDs. See case2.box/case2.usr.
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichletY/zeroNeumann
preconditioner = JACOBI
viscosity = 1e-4
residualTol = 1e-08
phases = phase0, phase1

# phase0 = continuous (Shaver et al. "c"): rho_c = 1.0, u_c = 1 and alpha_c = 0.7917 at
# inlet (Table II), accelerates/decelerates toward the fully-developed state (Table III)
# under gravity + variable-C_D drag reaction (userSource in case2.udf -- see Table I/II/III,
# eq 14-19 of trans_v116_n1_pp1251-1254.pdf).
[FLUID PHASE phase0]
# Explicit (not just inherited) -- must match [FLUID VELOCITY]'s boundaryTypeMap exactly;
# fluidSolver_t::setupEllipticSolver() hard-refuses if a phase's own BOUNDARY TYPE MAP
# option differs from the mixture's (mixed BC per phase isn't supported). The INI-level
# phase-inherits-from-mixture merge (parseFluidPhaseSections) did not reliably propagate
# this for a 3-entry map in testing here, so it's spelled out explicitly instead.
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichletY/zeroNeumann
rho = 1.0

# phase1 = dispersed (Shaver et al. "d"): rho_d = 0.2, D_d = 0.5, u_d = 1 and
# alpha_d = 0.2083 at inlet (Table II). Unlike case1, alpha_d genuinely evolves here --
# transported via the alphad scalar below (Plan G mechanism).
[FLUID PHASE phase1]
# Explicit, must match [FLUID VELOCITY] exactly -- see phase0's comment above.
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichletY/zeroNeumann
rho = 0.2

# Plan G alpha-transport scalar for phase1 (dispersed). "phase = phase1" here is consumed by
# parseScalar.hpp into "SCALAR<n> ALPHA PHASE", which nrs.cpp now (this session's fix) uses
# to pick THIS phase's own convecting velocity (fluid->o_relUrst_phases) for this scalar's
# advection -- previously that option was set but nothing downstream read it, so it had no
# effect (the scalar silently advected with the shared mixture velocity instead); fixed as
# part of the same o_relUrst_phases/o_relUrst_byScalar fix as the momentum equations. The
# push of this scalar's solution into fluid->o_alpha_phases[1] is still manual, via
# nrs->preFluid in case2.udf (setAlphaPhase/deriveLastAlphaPhase).
# diffusionCoeff is a small artificial numerical diffusivity (same order as the momentum
# equations' viscosity = 1e-4 regularizer below), not a physical input -- the paper's alpha
# transport (eq 15) has no diffusion term either.
# KNOWN LIMITATION (see README.md): eq 90 also needs a dilation term, alpha_d*div(u_d), that
# a plain advection-diffusion scalar equation cannot provide -- without it, alpha_d stays
# frozen at its inlet value (0.2083) instead of relaxing toward Table III. A real attempt to
# add this term (explicit source, implicit reaction term, AVM, clamping, under-relaxation)
# is backed up in case2_eq90_attempt.udf/.par: all variants hit a genuine, likely ill-posed
# feedback instability around t~0.22-0.32 (README.md, case2_eq90_instability.png). Reverted
# here to this stable-but-frozen-alpha state rather than ship a case that crashes.
[SCALAR alphad]
phase = phase1
diffusionCoeff = 1e-4
# Same 3 boundary IDs as [FLUID VELOCITY] (shared mesh boundaryID array, assigned in
# case2.usr): inlet Dirichlet, outlet zero-flux, symmetry zero-flux (no lateral alpha
# gradient expected across the SYM sides).
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-08

[CASEDATA]
# fieldExtract sampling cadence (in steps) -- read in case2.udf via platform->par->extract
# and used as the "tstep % ioSample == 0" guard in UDF_ExecuteStep. numSteps=128000 /
# ioSample=1600 gives exactly 80 .vts dumps total -- denser than the old 20, needed to
# resolve a time-history plot over the now-4x-longer run.
ioSample = 1600
